{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-lead-desk",
  "main": "./src/worker-global.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-lead-desk",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "ACCESS_AUD": "REPLACE_WITH_YOUR_CLOUDFLARE_ACCESS_AUDIENCE",
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_YOUR_TEAM.cloudflareaccess.com",
    "ENVIRONMENT": "production"
  }
}
