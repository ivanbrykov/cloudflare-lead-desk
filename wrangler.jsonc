{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-lead-desk",
  "main": "./src/worker-global.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-lead-desk",
      "database_id": "9731d183-325a-4bb2-bb47-e2effa289b59",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "ACCESS_AUD": "fcf0832bcec6343c1135f795a6dcffb4bfafe5b17d7b675db7801734c7c128af",
    "ACCESS_TEAM_DOMAIN": "brykov.cloudflareaccess.com",
    "ENVIRONMENT": "production"
  }
}
