    "@elysia/openapi": "^1.4.3",
    "@hookform/resolvers": "^5.2.2",
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-table": "^8.21.3",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.19.8",
    "elysia": "^1.4.3",
    "get-stream": "9.0.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.1",
    "tailwind-merge": "^3.4.0",
    "wouter": "^3.7.1"
