{
  "cloudflare": {
    "bindings": {
      "ACCESS_AUD": {
        "description": "The audience (AUD) tag of your Cloudflare Access application protecting this worker. Found in Zero Trust → Access → Applications."
      },
      "ACCESS_TEAM_DOMAIN": {
        "description": "Your Cloudflare Zero Trust team domain, e.g. `your-team.cloudflareaccess.com`."
      }
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
