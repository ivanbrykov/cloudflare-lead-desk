    "drizzle-kit": "^0.31.8",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-canonical": "^47.4.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "miniflare": "5.20260815.0-alpha",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.16",
