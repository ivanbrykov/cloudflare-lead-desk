  "engines": {
    "node": ">=24.20.0 <25"
  },
  "license": "Apache-2.0",
  "name": "cloudflare-lead-desk",
  "packageManager": "pnpm@10.34.5",
  "private": false,
  "scripts": {
    "build": "vite build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "dev": "vite",
    "dev:worker": "pnpm run build && wrangler dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0-alpha.0"
}
