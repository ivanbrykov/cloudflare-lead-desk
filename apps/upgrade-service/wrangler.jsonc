{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lead-desk-upgrade",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "GITHUB_CLIENT_ID": "SET_AFTER_APP_REGISTRATION",
    "GITHUB_APP_SLUG": "SET_AFTER_APP_REGISTRATION",
    "PUBLIC_ORIGIN": "https://lead-desk-upgrade.ivbr.workers.dev"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
